# What EAS Build uploads. When this file exists EAS uses it instead of .gitignore.
# Upload only the pnpm workspace files and the packages the mobile app builds from.
# Negations have no trailing slash: EAS tests folder paths as "src", not "src/".
/*
!/src
/src/*
!/src/package.json
!/src/pnpm-workspace.yaml
!/src/pnpm-lock.yaml
# pnpm patches (pnpm-workspace.yaml patchedDependencies): install fails with ERR_PNPM_PATCH_NOT_FOUND without them.
!/src/patches
!/src/ShipLean.Mobile
!/src/ShipLean.Core.Client
# ShipLean.Client is a workspace member: keep its package.json so pnpm's lockfile still matches.
!/src/ShipLean.Client
/src/ShipLean.Client/*
!/src/ShipLean.Client/package.json

node_modules/
.expo/
dist/
coverage/
*.log
