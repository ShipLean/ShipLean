{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Search eval corpus (one project)",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "sprints", "items"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "key", "name", "description"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "key": {"type": "string", "pattern": "^[A-Z]{2,4}$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "sprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "name", "goal", "startDate", "endDate"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "goal": {"type": "string"},
          "startDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "endDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "type", "title", "description", "acceptanceCriteria", "reproSteps", "tags", "state", "comments"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "type": {"enum": ["epic", "feature", "story", "bug", "task"]},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "acceptanceCriteria": {"type": "array", "items": {"type": "string"}},
          "reproSteps": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "state": {"enum": ["New", "Active", "Resolved", "Closed", "Removed"]},
          "parentRef": {"type": "string"},
          "sprintRef": {"type": "string"},
          "comments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "body", "archived"],
              "properties": {
                "ref": {"type": "string", "minLength": 1},
                "body": {"type": "string", "minLength": 1},
                "archived": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
