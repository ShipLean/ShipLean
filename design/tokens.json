{
  "$description": "ShipLean design tokens (Nord Frost, deepened). Mirrors design/tokens.css; keep both in sync.",
  "color": {
    "light": {
      "bg": "#e8eef7",
      "surface": "#f7f9fd",
      "surface-2": "#dfe7f3",
      "border": "#cdd9ea",
      "text": "#1c2638",
      "muted": "#52627c",
      "accent": "#2563c9",
      "accent-fg": "#ffffff",
      "accent-soft": "#dae6fb",
      "ok": "#3f8a3a",
      "warn": "#b7701b",
      "info": "#1d7fb8",
      "danger": "#c2353b",
      "purple": "#6f45bf"
    },
    "dark": {
      "bg": "#171e2d",
      "surface": "#1f2839",
      "surface-2": "#29344a",
      "border": "#334058",
      "text": "#eef2f8",
      "muted": "#a0aec6",
      "accent": "#5cc8f0",
      "accent-fg": "#06192a",
      "accent-soft": "#163a57",
      "ok": "#9fdc8a",
      "warn": "#f4cf72",
      "info": "#7aa7f5",
      "danger": "#f08a8f",
      "purple": "#b79cf5"
    }
  },
  "type": {
    "light": {
      "epic": "#d0731c",
      "feature": "#7b4fc9",
      "story": "#2f7fd8",
      "bug": "#cc3d3d",
      "task": "#c9951a"
    },
    "dark": {
      "epic": "#f0a35a",
      "feature": "#a989f0",
      "story": "#5aa5f5",
      "bug": "#f07070",
      "task": "#e6b84a"
    }
  },
  "paper": {
    "$description": "Paper cards are the same in both themes; only the edge, shadow and ring follow the theme.",
    "index": "#ffffff",
    "bug": "#ffe0e5",
    "postit": "#fff9d3",
    "postit-muted": "#6e5d22",
    "edge": {
      "light": { "mix": "#1c2638", "amount": "15%" },
      "dark": { "mix": "#000000", "amount": "28%" }
    },
    "postit-edge": {
      "light": { "mix": "#a8860f", "amount": "38%" },
      "dark": { "mix": "#000000", "amount": "28%" }
    },
    "shadow": {
      "light": "0 1px 2px rgb(16 24 40 / .10), 0 3px 8px -4px rgb(16 24 40 / .16)",
      "dark": "0 1px 1px rgb(0 0 0 / .45), 0 8px 18px -8px rgb(0 0 0 / .85)"
    }
  },
  "state-category": {
    "proposed": "muted",
    "in-progress": "info",
    "resolved": "warn",
    "completed": "ok",
    "removed": "danger"
  },
  "chart": {
    "light": { "committed": "#16a089", "completed": "#2563c9" },
    "dark": { "committed": "#1fa88c", "completed": "#3b82e0" }
  },
  "font": {
    "sans": "Inter, system-ui, -apple-system, Segoe UI, sans-serif",
    "mono": "ui-monospace, Cascadia Code, SF Mono, Menlo, monospace"
  },
  "text": {
    "2xs": "10.5px",
    "xs": "11px",
    "sm": "12px",
    "base": "13px",
    "md": "14px",
    "lg": "18px"
  },
  "radius": { "xs": "3px", "sm": "6px", "md": "8px", "lg": "10px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px" },
  "density": {
    "compact": {
      "bar-height": "38px",
      "control-height": "28px",
      "row-height": "32px",
      "rail-width": "280px",
      "sidebar-width": "216px"
    },
    "comfortable": {
      "bar-height": "44px",
      "control-height": "32px",
      "row-height": "38px",
      "rail-width": "320px",
      "sidebar-width": "248px"
    }
  }
}
