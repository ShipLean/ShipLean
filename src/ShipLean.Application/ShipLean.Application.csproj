<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShipLean.Contracts\ShipLean.Contracts.csproj" />
    <!-- Shared pure helpers (DisplayDate labels) used by queries that build DTOs. -->
    <ProjectReference Include="..\ShipLean.Core\ShipLean.Core.csproj" />
  </ItemGroup>

  <!-- WorkItemTypesTests (UnitTest) checks the internal WorkItemTypes rules directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ShipLean.UnitTest" />
  </ItemGroup>

  <!-- db/** ships inside the assembly, so the app and the test fixtures find the schema from any working directory. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\db\schema\*.sql" LogicalName="db/schema/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\db\migrations\*.sql" LogicalName="db/migrations/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\db\seed\*.sql" LogicalName="db/seed/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\db\blobs\*.sql" LogicalName="db/blobs/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Sprint demos: the prompt, ShipLean's default brand and the YouTube check clip ship inside the assembly (K11, K12). -->
  <ItemGroup>
    <EmbeddedResource Include="Features\Demos\Prompt\*.md" LogicalName="sprint-demo/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Features\Demos\Prompt\*.svg" LogicalName="sprint-demo/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Features\Demos\Prompt\*.css" LogicalName="sprint-demo/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Features\Demos\YouTube\*.mp4" LogicalName="sprint-demo/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Agoda.IoC.NetCore" Version="1.1.144" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.6" />
    <!-- Backup schedules (SHIP-743): Cronos parses and steps 5-field UTC cron expressions; the descriptor explains them in English. -->
    <PackageReference Include="CronExpressionDescriptor" Version="2.51.0" />
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
