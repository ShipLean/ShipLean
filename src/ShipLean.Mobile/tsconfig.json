{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    // Jest's globals for the jest-expo specs (*.spec.tsx). Vitest tests (*.test.ts) import from vitest.
    "types": ["jest"]
  },
  // .expo/types and expo-env.d.ts are generated by `expo start` (typed routes) and gitignored.
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "tools/voice-eval/.venv", "tools/voice-eval/out"]
}
