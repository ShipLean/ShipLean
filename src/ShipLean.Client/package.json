    "@uiw/react-md-editor": "^4.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/experimental-ct-react": "1.62.0",
    "@types/node": "^24.19.2",
